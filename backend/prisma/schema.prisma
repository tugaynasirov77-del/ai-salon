generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Salon {
  id               String         @id @default(cuid())
  name             String
  ownerName        String
  phone            String
  address          String?
  niche            String
  plan             String         @default("starter")
  telegramBotToken String?
  maxBotToken      String?
  avitoClientId    String?
  avitoClientSecret String?
  avitoUserId      String?
  yclientsCompanyId    String?
  yclientsCompanyTitle String?
  yclientsUserToken    String?
  yclientsServiceMap   Json?
  yclientsStaffMap     Json?
  yclientsLastSyncAt   DateTime?
  settings         Json?
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  clients          Client[]
  appointments     Appointment[]
  messages         Message[]
  services         Service[]
  masters          Master[]
  workingHours     WorkingHours[]
  faqs             Faq[]
  users            User[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("owner")
  salonId      String?
  salon        Salon?   @relation(fields: [salonId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?

  @@index([salonId])
}

model Client {
  id               String        @id @default(cuid())
  salonId          String
  name             String?
  phone            String?
  telegramId       String?
  maxId            String?
  vkId             String?
  avitoUserId      String?
  avitoChatId      String?
  webchatId        String?
  preferredChannel String        @default("telegram")
  createdAt        DateTime      @default(now())
  salon            Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointments     Appointment[]
  messages         Message[]

  @@index([salonId])
  @@index([telegramId])
  @@index([phone])
  @@index([webchatId])
  @@index([avitoUserId])
}

model Appointment {
  id          String   @id @default(cuid())
  salonId     String
  clientId    String
  serviceId   String?
  masterId    String?
  service     String
  master      String?
  datetime    DateTime
  status      String   @default("confirmed")
  source      String   @default("ai")
  yclientsRecordId String? @unique
  reminder24h Boolean  @default(false)
  reminder2h  Boolean  @default(false)
  createdAt   DateTime @default(now())
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceRef  Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  masterRef   Master?  @relation(fields: [masterId], references: [id], onDelete: SetNull)

  @@index([salonId])
  @@index([clientId])
  @@index([datetime])
  @@index([masterId])
}

model Message {
  id                String   @id @default(cuid())
  salonId           String
  clientId          String
  channel           String
  direction         String
  text              String
  intent            String?
  readByOwner       Boolean  @default(false)
  sentByOwner       Boolean  @default(false)
  inputTokens       Int?
  outputTokens      Int?
  cacheReadTokens   Int?
  cacheCreateTokens Int?
  createdAt         DateTime @default(now())
  salon             Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([salonId])
  @@index([clientId])
  @@index([createdAt])
}

model ChannelStatus {
  id        String   @id @default(cuid())
  channel   String   @unique
  isBlocked Boolean  @default(false)
  checkedAt DateTime @default(now())
}

model Service {
  id           String          @id @default(cuid())
  salonId      String
  name         String
  price        Int
  durationMin  Int?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  salon        Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  masters      MasterService[]
  appointments Appointment[]

  @@index([salonId])
}

model Master {
  id           String          @id @default(cuid())
  salonId      String
  name         String
  phone        String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  salon        Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  services     MasterService[]
  workingHours WorkingHours[]
  appointments Appointment[]

  @@index([salonId])
}

model MasterService {
  masterId  String
  serviceId String
  master    Master  @relation(fields: [masterId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([masterId, serviceId])
  @@index([serviceId])
}

model WorkingHours {
  id       String  @id @default(cuid())
  salonId  String
  masterId String?
  weekday  Int
  fromMin  Int
  toMin    Int
  salon    Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  master   Master? @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@index([salonId])
  @@index([masterId])
}

model Faq {
  id        String   @id @default(cuid())
  salonId   String
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId])
}
